# Local Makefile settings (`-include .env`)
.env

# Everything the container produces
build/
*.zip

# Python (tools/incontainer.py also runs on the host)
__pycache__/
*.pyc

# tools/ holds this environment's own tooling. The repository's .gitignore
# excludes any tools/ directory (there it is the desktop toolchain and gem5), so
# the exclusion is undone here.
!tools/
!tools/**

# The negations above re-include everything under tools/, bytecode included, so
# the Python section does not reach it.  Re-assert it here.
tools/__pycache__/
tools/*.pyc
