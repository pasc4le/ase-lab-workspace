# Copy to `.env` (git-ignored) to set these without passing them to make.
# Every value here is optional; the defaults live in the Makefile.

# 1: custom-patched gem5 container.  0: plain riscv64 image, native run.
CUSTOM_PATCH=1

# IMAGE=ghcr.io/pasc4le-labs/ase_riscv_gem5_sim:v1.0.0-a.1
# RISCV_IMAGE=ase-riscv:24.04
# PLATFORM=linux/riscv64
# TIMEOUT=180

# `make debug` front end: gdb (gdb-multiarch) or pwndbg.
# DEBUGGER=pwndbg
